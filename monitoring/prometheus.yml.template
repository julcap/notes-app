global:
  scrape_interval: 30s
  evaluation_interval: 1m

rule_files:
  - alerts.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - alertmanager.monitoring.svc.cluster.local:9093

scrape_configs:
  - job_name: minutes-backend
    metrics_path: /metrics
    authorization:
      type: Bearer
      credentials_file: ${METRICS_TOKEN_FILE}
    static_configs:
      - targets:
          - backend.minutes.svc.cluster.local:8000

  - job_name: minutes-health
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - targets:
          - ${APP_HEALTH_URL}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: blackbox-exporter.monitoring.svc.cluster.local:9115
